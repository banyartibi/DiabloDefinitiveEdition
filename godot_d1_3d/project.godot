; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Diablo: Definitive Edition - Godot 4 3D Next-Gen"
run/main_scene="res://scenes/main_3d.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

; Single shared authority instance: the soak writes its parity evidence to
; logs/parity_state.json, and only a singleton lets the running game start from that evidence
; instead of restarting the count at zero (AUTH_SHADOW) on every scene load.
[autoload]

logic_authority="*res://scripts/logic/d1_logic_authority.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=3
window/size/borderless=true
window/vsync/vsync_mode=0

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
scaling_3d/mode=2
scaling_3d/fsr_sharpness=1.0
environment/defaults/default_clear_color=Color(0.01, 0.01, 0.01, 1)
anti_aliasing/quality/screen_space_aa=1

[gui]

theme/custom_font="res://assets/fonts/Exocet.ttf"
