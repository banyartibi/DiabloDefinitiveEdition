class_name HdSpriteProvider
extends RefCounted
# ==============================================================================
# HdSpriteProvider: shared resolver for the OFFLINE-UPSCALED HD sprite assets
# (assets/hd_sprites*, generated by the C++ RemasterExporter + batch upscaler).
#
# Used by the native 3D sandbox (Mode 2) to render monsters, corpses, objects,
# missiles and ground items from the 4x+ HD PNG frames instead of the 1x bridge
# rasters. Mode 1 (native_25d_view.gd) keeps its own equivalent loaders.
#
# Frame naming on disk (batch_export_all_sprites_x4plus.py):
#   <folder>/<group-dir>_frame_<index>.png   (legacy: g<group>_f<idx>)
#   monsters: group = direction 0-7, index = engine anim_frame (0-based)
#   objects:  group = 0,          index = engine _oAnimFrame - 1 (0-based)
#   missiles: group = direction,  index = engine _miAnimFrame - 1 (0-based)
#
# Every load is cached (null results cached too, so missing files are not
# re-probed every frame) and screened for the pure-black silhouette corruption
# seen in some upscaler outputs.
# ==============================================================================

const UpscalerModelConfig = preload("res://scripts/upscaler_model_config.gd")

static var _cache: Dictionary = {}
static var _warned: Dictionary = {}

static func clear_cache() -> void:
	_cache.clear()

# ------------------------------------------------------------------------------
# Core frame loader with caching + corruption screening
# ------------------------------------------------------------------------------
static func _load_frame(dir_path: String, dir_idx: int, frame_idx: int) -> Texture2D:
	if frame_idx < 0 or dir_idx < 0:
		return null
	var file_names = [
		"dir_%d_frame_%d.png" % [dir_idx, frame_idx],
		"g%d_f%03d.png" % [dir_idx, frame_idx],
		"g%d_f%d.png" % [dir_idx, frame_idx],
	]
	for fname in file_names:
		var p = dir_path + "/" + fname
		if _cache.has(p):
			return _cache[p]
		if not FileAccess.file_exists(p):
			continue
		var img = Image.load_from_file(ProjectSettings.globalize_path(p))
		if img == null or img.is_empty():
			_cache[p] = null
			continue
		# Sample inside the non-empty bounding box: thin sprites (arrows, fireball
		# cores, portals) occupy a small fraction of the padded CEL canvas, so a
		# full-canvas grid sees zero opaque pixels and misreads them as corrupt.
		var used = img.get_used_rect()
		if used.size.x <= 0 or used.size.y <= 0:
			_cache[p] = null
			continue
		if _is_black(img, used):
			_cache[p] = null
			if not _warned.has(p):
				_warned[p] = true
				push_warning("HdSpriteProvider: corrupted black HD frame: " + p)
			continue
		img.generate_mipmaps()
		var tex = ImageTexture.create_from_image(img)
		_cache[p] = tex
		return tex
	return null

static func _resolve(sub_path: String, dir_idx: int, frame_idx: int, model_id: int) -> Texture2D:
	var folder: String = UpscalerModelConfig.get_sprite_folder(model_id)
	var tex = _load_frame(folder + "/" + sub_path, dir_idx, frame_idx)
	if tex == null and model_id != 0:
		tex = _load_frame(UpscalerModelConfig.get_sprite_folder(0) + "/" + sub_path, dir_idx, frame_idx)
	return tex

# Corruption screening: pure-black silhouette masks (upscaler failures on
# transparent/palette edge cases). Samples a grid inside `rect`, which callers
# pass as the image's used rect so small sprites are still measured.
static func _is_black(img: Image, rect: Rect2i = Rect2i()) -> bool:
	var w = img.get_width()
	var h = img.get_height()
	if w == 0 or h == 0:
		return true
	var x0 = 0
	var y0 = 0
	var x1 = w
	var y1 = h
	if rect.size.x > 0 and rect.size.y > 0:
		x0 = clampi(rect.position.x, 0, w - 1)
		y0 = clampi(rect.position.y, 0, h - 1)
		x1 = clampi(rect.position.x + rect.size.x, x0 + 1, w)
		y1 = clampi(rect.position.y + rect.size.y, y0 + 1, h)
	var opaque = 0
	var black = 0
	var samples = 0
	var step_x = max(1, int((x1 - x0) / 16))
	var step_y = max(1, int((y1 - y0) / 16))
	for y in range(y0, y1, step_y):
		for x in range(x0, x1, step_x):
			var c = img.get_pixel(x, y)
			if c.a > 0.05:
				opaque += 1
				if c.r < 0.03 and c.g < 0.03 and c.b < 0.03:
					black += 1
			samples += 1
	if samples == 0:
		return true
	if opaque < int(samples * 0.01):
		return true
	if opaque > 0 and black >= int(opaque * 0.98):
		return true
	return false

