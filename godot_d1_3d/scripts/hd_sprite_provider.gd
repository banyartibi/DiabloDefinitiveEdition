static func _resolve_prefix(m_name: String) -> String:
	var name_lower = m_name.strip_edges().to_lower()
	var prefix = MONSTER_NAME_MAP.get(name_lower, "")
	if prefix == "":
		if "butcher" in name_lower:
			prefix = "fatc_fatc"
		elif "leoric" in name_lower or "skeleton king" in name_lower:
			prefix = "sking_sking"
		elif "diablo" in name_lower:
			prefix = "diablo_diablo"
		elif "skeleton" in name_lower or "skel" in name_lower:
			prefix = "skelaxe_sklax"
		elif "fallen" in name_lower or "carver" in name_lower:
			prefix = "falspear_phall"
		elif "zombie" in name_lower or "ghoul" in name_lower:
			prefix = "zombie_zombie"
		elif "overlord" in name_lower or "fat" in name_lower:
			prefix = "fat_fat"
		elif "scav" in name_lower or "beast" in name_lower:
			prefix = "scav_scav"
		elif "goat" in name_lower or "satyr" in name_lower:
			prefix = "goatmace_goat"
		elif "bat" in name_lower or "fiend" in name_lower:
			prefix = "bat_bat"
		elif "spider" in name_lower:
			prefix = "spider_spider"
		elif "acid" in name_lower or "spitter" in name_lower:
			prefix = "acid_acid"
		elif "knight" in name_lower:
			prefix = "black_black"
		elif "witch" in name_lower or "succubus" in name_lower:
			prefix = "succ_scbs"
		elif "gargoyle" in name_lower:
			prefix = "gargoyle_gargo"
		elif "magma" in name_lower:
			prefix = "magma_magma"
		elif "snake" in name_lower or "viper" in name_lower:
			prefix = "snake_snake"
		elif "mage" in name_lower:
			prefix = "mage_mage"
	return prefix

static func _mode_to_action(mode: int) -> String:
	match mode:
		0, 13, 17:
			return "stand"
		1, 2, 3:
			return "walk"
		4, 10, 14:
			return "attack"
		5:
			return "hit"
		6:
			return "death"
		7, 8, 9, 11, 12, 16:
			return "special"
		_:
			return "walk"

static func get_monster_sprite(m_name: String, mode: int, dir: int, frame: int, model_id: int) -> Texture2D:
	var prefix = _resolve_prefix(m_name)
	if prefix == "":
		return null
	# Towner NPCs lack textured HD sheets: keep live bridge raster (Mode 1 policy).
	if prefix.begins_with("towners_"):
		return null
	var act = _mode_to_action(mode)
	var sub = "monsters/%s_%s" % [prefix, act]
	var tex = _resolve(sub, dir, frame, model_id)
	if tex != null:
		return tex
	# Legacy directory aliases (same set as Mode 1).
	var alias = ""
	if prefix == "skelaxe_sklax":
		alias = "monsters/skeleton_%s" % ("death" if act == "death" else "walk")
	elif prefix == "falspear_phall" and act == "walk":
		alias = "monsters/fallen_walk"
	elif prefix == "zombie_zombie" and act == "walk":
		alias = "monsters/zombie_walk"
	elif prefix == "fatc_fatc":
		alias = "monsters/butcher_%s" % act
	elif prefix == "sking_sking":
		alias = "monsters/sking_%s" % act
	elif prefix == "diablo_diablo":
		alias = "monsters/diablo_%s" % act
	if alias != "":
		return _resolve(alias, dir, frame, model_id)
	return null

static func get_corpse_sprite(m_name: String, dir: int, frame: int, model_id: int) -> Texture2D:
	var prefix = _resolve_prefix(m_name)
	if prefix == "" or prefix.begins_with("towners_"):
		return null
	return _resolve("monsters/%s_death" % prefix, dir, frame, model_id)

# ------------------------------------------------------------------------------
# Objects: bridge exposes the CEL graphic name (ObjMasterLoadList[ofindex]).
# Engine _oAnimFrame is 1-based; HD frame index is 0-based.
# ------------------------------------------------------------------------------
static func get_object_sprite(graphic: String, anim_frame_1based: int, model_id: int) -> Texture2D:
	if graphic == "":
		return null
	var frame_idx = max(0, anim_frame_1based - 1)
	return _resolve("objects/" + graphic, 0, frame_idx, model_id)

# ------------------------------------------------------------------------------
# Missiles: bridge exposes the MissileSpriteData cel name.
# Engine _miAnimFrame is 1-based; HD frame index is 0-based.
# ------------------------------------------------------------------------------
static func get_missile_sprite(cel: String, dir: int, anim_frame_1based: int, model_id: int) -> Texture2D:
	if cel == "":
		return null
	var frame_idx = max(0, anim_frame_1based - 1)
	var tex = _resolve("missiles/" + cel, dir, frame_idx, model_id)
	if tex == null and dir != 0:
		# Direction-agnostic missile sheets export everything under dir_0.
		tex = _resolve("missiles/" + cel, 0, frame_idx, model_id)
	return tex

# ------------------------------------------------------------------------------
# Ground items: curs_<id> flip animation frames (deploy_hd_ground_items.py).
# ------------------------------------------------------------------------------
static func get_item_sprite(curs_id: int, anim_frame: int, model_id: int) -> Texture2D:
	var sub = "items/curs_%d_f%d.png" % [curs_id, anim_frame]
	var sub2 = "items/curs_%d.png" % curs_id
	for folder_id in [model_id, 0]:
		if folder_id == 0 and model_id == 0:
			continue
		var folder: String = UpscalerModelConfig.get_sprite_folder(folder_id)
		for p in [folder + "/" + sub, folder + "/" + sub2]:
			if _cache.has(p):
				return _cache[p]
			if not FileAccess.file_exists(p):
				continue
			var img = Image.load_from_file(ProjectSettings.globalize_path(p))
			if img == null or img.is_empty() or _is_black(img):
				_cache[p] = null
				continue
			var used_rect = img.get_used_rect()
			if used_rect.size.x > 0 and used_rect.size.y > 0:
				img = img.get_region(used_rect)
			img.generate_mipmaps()
			var tex = ImageTexture.create_from_image(img)
			_cache[p] = tex
			return tex
	return null
